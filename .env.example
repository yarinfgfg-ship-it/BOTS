# Copy this file to .env and fill in the values.

# Required: your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Required: your application's client ID (for slash command registration)
CLIENT_ID=your_client_id_here

# Required for OAuth2 / verify site: application secret and redirect URL.
CLIENT_SECRET=
REDIRECT_URI=http://localhost:3000/callback
# Cloud: set this to https://your-app.onrender.com/callback
# OAUTH_PORT=3000
# DATA_DIR=/app/data

# Recommended while testing: your test server ID (guild ID).
# Leave blank to register commands globally instead.
GUILD_ID=your_test_server_id_here

# ID of the category where ticket channels should be created.
TICKET_CATEGORY_ID=

# Comma-separated role IDs allowed to see/claim tickets, e.g. 123456,789101
SUPPORT_ROLE_IDS=

# Comma-separated admin role IDs that can list/close/rename any ticket.
# Can also be set per guild with /ticket-admin-role add role:@role
ADMIN_ROLE_IDS=

# Optional channel ID where ticket transcripts are logged.
LOG_CHANNEL_ID=

# Set to true (after enabling Server Members Intent in the Developer Portal)
# to send an automatic welcome message when someone joins.
ENABLE_MEMBERS_INTENT=false

# Comma-separated user IDs allowed to use /dm and /alert (bot creator only).
# Leave empty to disable those commands for everyone.
BOT_OWNER_IDS=

# Category IDs for each ticket dropdown option (leave blank to auto-create).
CATEGORY_SUPPORT_ID=
CATEGORY_BUG_ID=
CATEGORY_QUESTION_ID=
